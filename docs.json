          },
          {
            "group": "센터 운영자 가이드",
            "pages": [
              "create-center",
              {
                "group": "센터 관리",
                "pages": [
                  "dashboard",
                  "class",
                  "enrollment",
                  "students",
                  "instructor",
                  "settings",
                  "team",
                  "billing"
                ]
              }
            ]
          },
          {
            "group": "활용하기",
            "pages": [
              "share-link"
            ]
          },
          {
            "group": "자주 묻는 질문",
            "pages": [
              "faq-center"
            ]
          }
        ]
      },
      {
        "tab": "수강생 가이드",
        "pages": [
          "apply",
          "my-status",
          "cancel",
          "student-faq"
        ]
      }
    ]
  },
  "logo": "/images/cf-logo-h28.png",
